#!/usr/bin/env python3

import json
import os
import signal
import sys
import tempfile
import time
from copy import deepcopy
from datetime import datetime, timedelta, timezone
from pathlib import Path


def fail(message, exit_code=2):
    print(json.dumps({"ok": False, "error": message}), file=sys.stderr)
    raise SystemExit(exit_code)


def option(args, name, fallback=None):
    try:
        return args[args.index(name) + 1]
    except (ValueError, IndexError):
        if fallback is not None:
            return fallback
        fail(f"Missing required option: {name}")


def load_fixture():
    default = Path(__file__).resolve().parent.parent / "fixtures" / "screenshot.json"
    path = Path(os.environ.get("HEY_DEMO_FIXTURE", default))
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as error:
        fail(f"Could not load demo fixture {path}: {error}")


def state_path():
    default_dir = Path(tempfile.gettempdir()) / f"omarchy-hey-demo-{os.getuid()}"
    directory = Path(os.environ.get("HEY_DEMO_STATE_DIR", default_dir))
    directory.mkdir(parents=True, exist_ok=True)
    return directory / "state.json"


def load_state():
    path = state_path()
    if not path.exists():
        return {"seen_ids": []}
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as error:
        fail(f"Could not load demo state: {error}")


def save_state(state):
    path = state_path()
    temporary = path.with_suffix(".tmp")
    temporary.write_text(json.dumps(state))
    temporary.replace(path)


def rendered_posting(source, seen, now):
    posting = deepcopy(source)
    minutes_ago = int(posting.pop("minutes_ago"))
    posting.pop("state", None)
    timestamp = now - timedelta(minutes=minutes_ago)
    formatted = timestamp.isoformat(timespec="milliseconds").replace("+00:00", "Z")
    posting["created_at"] = formatted
    posting["updated_at"] = formatted
    posting["active_at"] = formatted
    posting["seen"] = seen
    posting["app_url"] = ""
    return posting


def day_key(value):
    return value.strftime("%Y-%m-%d")


def utc_midnight(day):
    return datetime(day.year, day.month, day.day, tzinfo=timezone.utc)


def stamp(value):
    return value.isoformat(timespec="milliseconds").replace("+00:00", "Z")


# Calendar fixtures are written relative to today — "in two days at 14:00" —
# so the demo always has a day worth looking at, whenever it is run.
def rendered_event(source, today):
    event = deepcopy(source)
    starts_in = int(event.pop("days_from_today", 0))
    length = int(event.pop("minutes", 60))
    day = today + timedelta(days=starts_in)
    at = event.pop("at", None)

    if at is None:
        spans = int(event.pop("days", 1))
        event["all_day"] = True
        event["starts_at"] = stamp(utc_midnight(day))
        event["ends_at"] = stamp(utc_midnight(day + timedelta(days=spans)))
    else:
        hour, minute = (int(part) for part in at.split(":"))
        # Local wall-clock time, which is what a day view shows.
        start = datetime(day.year, day.month, day.day, hour, minute).astimezone(timezone.utc)
        event.pop("days", None)
        event["all_day"] = False
        event["starts_at"] = stamp(start)
        event["ends_at"] = stamp(start + timedelta(minutes=length))

    event.setdefault("recurring", False)
    event["created_at"] = stamp(utc_midnight(today))
    event["updated_at"] = event["created_at"]
    event["edit_url"] = ""
    return event


def rendered_todo(source, today):
    todo = deepcopy(source)
    starts_in = int(todo.pop("days_from_today", 0))
    spans = int(todo.pop("days", 1))
    day = today + timedelta(days=starts_in)
    todo["all_day"] = True
    todo["starts_at"] = stamp(utc_midnight(day))
    todo["ends_at"] = stamp(utc_midnight(day + timedelta(days=spans)))
    todo["created_at"] = todo["starts_at"]
    todo["updated_at"] = todo["starts_at"]
    return todo


def within_window(record, args):
    starts_on = option(args, "--starts-on", "")
    ends_on = option(args, "--ends-on", "")
    if not starts_on or not ends_on:
        return True
    # A repeating event is answered whatever window is asked for, the way the
    # real CLI answers one.
    if record.get("recurring"):
        return True
    return record["starts_at"][:10] <= ends_on and record["ends_at"][:10] >= starts_on


def list_events(fixture, args):
    today = datetime.now().date()
    events = [rendered_event(source, today) for source in fixture.get("events", [])]
    print(json.dumps({"ok": True, "data": [item for item in events if within_window(item, args)]}))


def list_todos(fixture, args):
    today = datetime.now().date()
    todos = [rendered_todo(source, today) for source in fixture.get("todos", [])]
    completed = {str(value) for value in load_state().get("completed_todo_ids", [])}
    for todo in todos:
        if str(todo["id"]) in completed:
            todo["completed_at"] = stamp(datetime.now(timezone.utc))
    print(json.dumps({"ok": True, "data": [item for item in todos if within_window(item, args)]}))


def list_calendars(fixture):
    print(json.dumps({"ok": True, "data": fixture.get("calendars", [])}))


def complete_todo(fixture, args):
    todo_id = str(args[2])
    if not any(str(item["id"]) == todo_id for item in fixture.get("todos", [])):
        fail(f"Unknown demo todo: {todo_id}")
    state = load_state()
    completed = {str(value) for value in state.get("completed_todo_ids", [])}
    completed.add(todo_id)
    state["completed_todo_ids"] = sorted(completed)
    save_state(state)
    print(json.dumps({"ok": True, "data": {"id": todo_id, "completed": True}}))


# The demo does not persist what it is asked to create; it answers the way the
# CLI does so the panel's own re-read is exercised.
def added(kind, args):
    print(json.dumps({"ok": True, "data": {"id": 900001, "title": args[2]}, "summary": f"{kind} created"}))


def auth_status():
    print(json.dumps({
        "ok": True,
        "data": {"authenticated": True, "expired": False},
        "summary": "Authenticated",
    }))


def list_accounts(fixture):
    print(json.dumps({"ok": True, "data": fixture["accounts"]}))


def list_imbox(fixture, args):
    selected = option(args, "--account", "all")
    limit = int(option(args, "--limit", "50"))
    seen_ids = {str(value) for value in load_state().get("seen_ids", [])}
    now = datetime.now(timezone.utc)
    postings = []
    for source in fixture["postings"]:
        if selected != "all" and str(source["account_id"]) != str(selected):
            continue
        postings.append(rendered_posting(source, str(source["id"]) in seen_ids or source.get("state") == "seen", now))
    postings.sort(key=lambda item: item["active_at"], reverse=True)
    print(json.dumps({
        "ok": True,
        "data": {
            "id": 1,
            "name": "Imbox",
            "postings": postings[:limit],
            "total_count": len(postings),
        },
    }))


def mark_seen(fixture, args):
    if len(args) < 2:
        fail("Missing posting id")
    posting_id = str(args[1])
    account_id = str(args[3])
    if not any(str(item["id"]) == posting_id and str(item["account_id"]) == account_id
               for item in fixture["postings"]):
        fail(f"Unknown demo posting: {posting_id}")
    state = load_state()
    seen_ids = {str(value) for value in state.get("seen_ids", [])}
    seen_ids.add(posting_id)
    state["seen_ids"] = sorted(seen_ids)
    save_state(state)
    print(json.dumps({"ok": True, "data": {"id": posting_id, "seen": True}}))


def watch():
    def stop(_signum, _frame):
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    print(json.dumps({"change": "ready"}), flush=True)
    while True:
        time.sleep(3600)


def valid_tui_command(args):
    try:
        tui_index = args.index("tui")
    except ValueError:
        return False

    prefix = args[:tui_index]
    if prefix and not (len(prefix) == 2 and prefix[0] == "--account"
                       and prefix[1].isdigit() and int(prefix[1]) > 0):
        return False

    values = {}
    remote = False
    index = tui_index + 1
    while index < len(args):
        flag = args[index]
        if flag == "--remote":
            if remote:
                return False
            remote = True
            index += 1
            continue
        if flag not in ("--instance", "--topic", "--topic-title") or flag in values or index + 1 >= len(args):
            return False
        values[flag] = args[index + 1]
        index += 2

    if values.get("--instance") != "omarchy":
        return False
    topic = values.get("--topic", "")
    if topic and (not topic.isdigit() or int(topic) <= 0):
        return False
    if (remote or "--topic-title" in values) and not topic:
        return False
    return True


def main():
    fixture = load_fixture()
    args = sys.argv[1:]

    if args == ["--version"]:
        print("hey version 1.2.0")
    elif args == ["auth", "status", "--json"]:
        auth_status()
    elif args == ["setup", "--silent-success"]:
        print("SETUP COMPLETE")
    elif args in (["account", "list", "--json"], ["accounts", "list", "--json"]):
        list_accounts(fixture)
    elif args in (
        ["box", "imbox", "--limit", "50", "--json"],
        ["box", "imbox", "--account", "all", "--limit", "50", "--json"],
    ):
        list_imbox(fixture, args)
    elif args == ["screener", "list", "--count", "--json"]:
        print(int(fixture.get("screener_count", 0)))
    elif (len(args) == 5 and args[0] == "seen" and args[1].isdigit()
          and args[2] == "--account" and args[3].isdigit() and args[4] == "--json"):
        mark_seen(fixture, args)
    elif args == ["--account", "all", "watch", "--events", "added,updated,deleted,new,resync"]:
        watch()
    elif args[:4] == ["event", "list", "--all", "--starts-on"] and args[-1] == "--json":
        list_events(fixture, args)
    elif args[:4] == ["todo", "list", "--all", "--starts-on"] and args[-1] == "--json":
        list_todos(fixture, args)
    elif args == ["calendar", "list", "--json"]:
        list_calendars(fixture)
    elif args[:2] == ["event", "add"] and "--json" in args:
        added("Event", args)
    elif args[:2] == ["todo", "add"] and "--json" in args:
        added("Todo", args)
    elif args[:2] == ["todo", "complete"] and args[-1] == "--json":
        complete_todo(fixture, args)
    elif valid_tui_command(args):
        return
    else:
        fail("Unsupported demo HEY CLI command: " + " ".join(args))


if __name__ == "__main__":
    main()
